    "types": ["percentage","fixed","tiered","bonus"],
    "ledger": ["expected","reported","received","variance","payment status","expected date","received date"]
  },
  "automation_engine": {
    "events": ["StudentCreated","DocumentUploaded","DocumentVerified","EligibilityCompleted","ShortlistGenerated","ApplicationCreated","ApplicationApproved","ApplicationSubmitted","OfferReceived","DeadlineApproaching","CommissionReceived"],
    "actions": ["CreateTask","SendNotification","RunEligibility","GenerateShortlist","RunPreflight","QueueSubmission","UpdateStatus"],
    "requirements": ["permissions","conditions","execution history","retry policy","failure state","audit"]
  },
  "analytics": ["leads","students","applications","offers","deposits","enrolments","conversion","processing time","document completion","submission success","revenue","commission","counsellor performance","university performance","country performance","course performance"],
  "ai_governance": ["provider","model","prompt version","input snapshot/hash where safe","output","confidence","timestamp","human override","final decision"],
